{
  "name": "ouastihamza.github.io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/finalize-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:portfolio-2": "npm --prefix apps/portfolio-2 run build",
    "predev": "npm run build:portfolio-2",
    "prebuild": "npm run build:portfolio-2",
    "postinstall": "npm --prefix apps/portfolio-2 ci",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "next": "16.3.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "type": "module"
}
